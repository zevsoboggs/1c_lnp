{
  "name": "loveandpay-superadmin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c magenta,cyan -k \"npm:dev:server\" \"npm:dev:front\"",
    "dev:server": "node --env-file=.env --watch node_modules/.bin/tsx server/index.ts",
    "dev:front": "vite",
    "server": "npm run dev:server",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "start": "node node_modules/.bin/tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.101.2",
    "antd": "5.29.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "1.11.21",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "^10.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2"
  }
}
