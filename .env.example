# Скопируй в .env и подставь ключ.
ADMIN_API_KEY=
ADMIN_API_URL=https://loveandpay.io
DATABASE_URL=postgresql://user:pass@host:5432/dbname
RAPIRA_API=https://api.rapira.net/market/symbol-thumb
PORT=5274
PAYSPACE_API_KEY=
PAYSPACE_SECRET=
PAYSPACE_API_URL=https://app.pay.space
MINIAPP_ADMIN_KEY=
MINIAPP_API_URL=https://lnpapp.rest

# Карты HiCard — раздел «Карты». Ключи боевые, у песочницы свои.
HICARD_BASE_URL=https://api.hicard.tech
HICARD_ACCESS_KEY=
HICARD_ACCESS_SECRET=

# SberPay через NPay — раздел «SberPay». Только чтение: остаток и статус ссылок.
NPAY_BASE_URL=
NPAY_MERCHANT_GUID=
NPAY_API_KEY=

# Только для локального http-дева. В проде НЕ ставить — cookie должна быть Secure.
# ADMIN_INSECURE_COOKIE=1
